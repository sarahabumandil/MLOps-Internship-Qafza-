# Copy to .env and fill in real values for local docker-compose runs.
# Never commit the real .env file.

POSTGRES_USER=mlops
POSTGRES_PASSWORD=change_me
POSTGRES_DB=olist_inference

MLFLOW_TRACKING_URI=http://mlflow:5000
MODEL_STAGE=Production

LOG_LEVEL=INFO

# DVC remote (S3-compatible) — set these in your shell / CI secrets, not here.
DVC_REMOTE_URL=s3://olist-mlops-artifacts/dvc-store
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
