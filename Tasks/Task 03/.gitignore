logs/
data/monitoring/*.jsonl

# Reports
reports/figures/*.png

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# IDE
.vscode/
.idea/
.DS_Store

# Great Expectations local run artifacts
great_expectations/uncommitted/
